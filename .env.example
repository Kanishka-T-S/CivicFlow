# Copy this file to .env and fill in your key. NEVER commit .env.
GNANI_API_KEY=replace_with_your_Gnani_API_key

# Verified v3.0 supports bilingual language selection and codemix output.
GNANI_STT_MODEL=prisma-v3.0

GNANI_STT_LANGUAGE=ta-IN,en-IN

GNANI_STT_FORMAT=codemix

# SQLite database path; the default storage directory is Git-ignored.
CIVICFLOW_DATABASE_PATH=storage/civicflow.sqlite3

# Leave empty to keep administrator access disabled. Fill these locally to enable it.
CIVICFLOW_SECRET_KEY=
CIVICFLOW_ADMIN_USERNAME=
CIVICFLOW_ADMIN_PASSWORD_HASH=

# Set to true when serving over HTTPS; leave false for local HTTP development.
CIVICFLOW_COOKIE_SECURE=false
